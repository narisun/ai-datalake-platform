{
  "catalogs": [
    {"user": "svc_pipeline", "catalog": "lake", "allow": "all"},
    {"user": "svc_pipeline", "catalog": "system", "allow": "read-only"},
    {"user": "svc_catalog", "catalog": "lake", "allow": "read-only"},
    {"allow": "none"}
  ],
  "schemas": [
