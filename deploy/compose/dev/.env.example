# Secrets for the dev stack. Do not edit this file: run
#   python deploy/compose/dev/init_env.py
# which writes .env beside it with a generated value for every `change-me`. Run it
# again after pulling changes: it adds any new entries and leaves existing ones alone.
# .env is ignored by Git.

POSTGRES_PASSWORD=change-me
OPENMETADATA_DB_PASSWORD=change-me
AIRFLOW_DB_PASSWORD=change-me
POLARIS_DB_PASSWORD=change-me
CONTROL_DB_PASSWORD=change-me

POLARIS_CLIENT_ID=datalake
POLARIS_CLIENT_SECRET=change-me
POLARIS_TOKEN_SECRET=change-me

# Trino sign-in: one password per service account, and Trino's internal secret.
TRINO_PIPELINE_PASSWORD=change-me
TRINO_CATALOG_PASSWORD=change-me
TRINO_APP_PASSWORD=change-me
TRINO_SHARED_SECRET=change-me

# For `dl ask`: the agent's model calls go to the Claude API. Leave empty to run
# everything else. Put your key in .env (never here), then recreate the airflow container.
ANTHROPIC_API_KEY=
